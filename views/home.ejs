<%- include("partials/header"); -%>

<div class="hero">

    <span class="hero-label">EST. 2023</span>

    <h1>Daily Journal</h1>

    <p>
        A curated collection of stories, ideas,
        experiences and perspectives.
    </p>

</div>

<% posts.forEach(function(post){ %>

<div class="post-preview">

    <div class="post-meta">
        Article
    </div>

    <h2><%= post.title %></h2>

    <p>
        <%= post.content.substring(0,220) %>...
    </p>

    <a href="/posts/<%= post._id %>">
        Read Article →
    </a>

</div>

<% }) %>

<%- include("partials/footer"); -%>